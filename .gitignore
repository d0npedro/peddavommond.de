# dependencies / build
node_modules/
.vercel/
.next/
.vinext/
dist/
.wrangler/
.cache/
*.tsbuildinfo
.dev-server*.log
work/

# Embedded SPAs — produced by scripts/embed-*.mjs (vercel-build)
public/multi-agent/
